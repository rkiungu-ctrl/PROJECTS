# =================================================================
# PAYSLIP EMAIL SYSTEM - MULTI-COMPANY CONFIGURATION TEMPLATE
# Copy this file to .env and configure for your company
# =================================================================

# SELECT YOUR EMAIL PROVIDER (uncomment one section below)

# =================================================================
# OPTION 1: GMAIL (Google Workspace or personal Gmail)
# =================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=hr@yourcompany.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=hr@yourcompany.com

# Gmail Setup Steps:
# 1. Enable 2-Factor Authentication: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character App Password above (not regular password)

# =================================================================
# OPTION 2: OUTLOOK/HOTMAIL (Microsoft)
# =================================================================
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USER=hr@yourcompany.com
# SMTP_PASS=your-outlook-password
# SMTP_FROM=hr@yourcompany.com

# Outlook Setup Steps:
# 1. Use your regular Outlook password
# 2. Ensure "Less secure app access" is enabled if needed
# 3. May require enabling SMTP in Outlook settings

# =================================================================
# OPTION 3: YAHOO MAIL
# =================================================================
# SMTP_HOST=smtp.mail.yahoo.com
# SMTP_PORT=465
# SMTP_USER=hr@yourcompany.com
# SMTP_PASS=your-yahoo-app-password
# SMTP_FROM=hr@yourcompany.com

# Yahoo Setup Steps:
# 1. Enable 2-Factor Authentication
# 2. Generate App Password in Yahoo Account Security
# 3. Use App Password above (not regular password)

# =================================================================
# OPTION 4: CUSTOM BUSINESS EMAIL (company domain)
# =================================================================
# SMTP_HOST=mail.yourcompany.com
# SMTP_PORT=587
# SMTP_USER=hr@yourcompany.com
# SMTP_PASS=your-business-email-password
# SMTP_FROM=hr@yourcompany.com

# Custom Email Setup Steps:
# 1. Contact your IT department or hosting provider
# 2. Get SMTP server details (host, port, authentication)
# 3. Common ports: 587 (TLS), 465 (SSL), 25 (unsecured)

# =================================================================
# TESTING
# =================================================================
# After configuration, test by clicking "Email" button in payslip modal
# Check server logs for detailed error messages if sending fails